{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "automerge": false,
  "packageRules": [
    {
      "description": "Group non-major Ansible collection updates into one PR",
      "matchManagers": [
        "ansible-galaxy"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "Ansible collections",
      "groupSlug": "ansible-collections"
    },
    {
      "description": "Group non-major GitHub Actions updates into one PR",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    }
  ]
}
